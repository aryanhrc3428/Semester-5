%%{init: {
  "flowchart": {
    "htmlLabels": true,
    "nodeSpacing": 40,
    "rankSpacing": 90,
    "padding": 15
  }
}}%%
flowchart LR

    %% -------------------------------------------------------------
    %% COLUMN 1: ACTORS
    %% -------------------------------------------------------------
    subgraph Actors [" "]
        direction TB
        Student["<b>Student</b>"]
    end

    %% -------------------------------------------------------------
    %% COLUMN 2: SUB-PROCESSES (Decomposition of 4.0)
    %% -------------------------------------------------------------
    subgraph SubProcesses [" "]
        direction TB
        P4_1(("<b>4.1</b><br/>Fetch & Filter<br/>Query List"))
        P4_2(("<b>4.2</b><br/>Retrieve Specific<br/>Ticket Details"))
        P4_3(("<b>4.3</b><br/>Parse Workflow<br/>State (A1/A2/A3)"))
        P4_4(("<b>4.4</b><br/>Render Status<br/>Dashboard"))
    end

    %% -------------------------------------------------------------
    %% COLUMN 3: DATA STORES & UI SINKS
    %% -------------------------------------------------------------
    subgraph DataStores [" "]
        direction TB
        D3@{ shape: datastore, label: "<b>D3: QUERIES</b><br/>(Tickets DB)" }
        StudentDash(("Student Dashboard<br/>(UI View)"))
    end

    %% =============================================================
    %% DATA FLOWS
    %% =============================================================

    %% --- 4.1 Fetch List ---
    Student -->|"1. Open 'Query Status' Page"| P4_1
    P4_1 <-->|"2. Read tickets filtered by<br/>student_id (Privacy Rule)"| D3
    P4_1 -->|"3. Pass Summaries"| P4_4
    
    %% --- 4.2 Fetch Details ---
    Student -->|"4. Select Specific Query"| P4_2
    P4_2 <-->|"5. Read payload by query_id<br/>(Read-Only)"| D3
    
    %% --- 4.3 Parse State ---
    P4_2 -->|"6. Pass Full Ticket Payload"| P4_3
    P4_3 -->|"7. Apply State Logic:<br/>• A1: Forwarded to TIC<br/>• A2: Pending Resolution<br/>• A3: Resolved & Instructions"| P4_4
    
    %% --- 4.4 Render Dashboard ---
    P4_1 & P4_2 -->|"Alt A4: Data Unavailable Error"| P4_4
    P4_4 -->|"8. Display Formatted Details,<br/>Timestamps & Next Actions"| StudentDash

    %% -------------------------------------------------------------
    %% STYLING
    %% -------------------------------------------------------------
    style Actors fill:none, stroke:none
    style DataStores fill:none, stroke:none
    style SubProcesses fill:none, stroke:none