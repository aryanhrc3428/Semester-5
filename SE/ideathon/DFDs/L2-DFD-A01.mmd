%%{init: {
  "flowchart": {
    "htmlLabels": true,
    "nodeSpacing": 40,
    "rankSpacing": 90,
    "padding": 15
  }
}}%%
flowchart LR

    %% -------------------------------------------------------------
    %% COLUMN 1: ACTORS
    %% -------------------------------------------------------------
    subgraph Actors [" "]
        direction TB
        Admin["<b>Admin</b>"]
    end

    %% -------------------------------------------------------------
    %% COLUMN 2: SUB-PROCESSES (Decomposition of 8.0)
    %% -------------------------------------------------------------
    subgraph SubProcesses [" "]
        direction TB
        P8_1(("<b>8.1</b><br/>Fetch & Filter<br/>Global Queue"))
        P8_2(("<b>8.2</b><br/>Retrieve Full<br/>Ticket Payload"))
        P8_3(("<b>8.3</b><br/>Parse State &<br/>Render Dashboard"))
    end

    %% -------------------------------------------------------------
    %% COLUMN 3: DATA STORES & UI SINKS
    %% -------------------------------------------------------------
    subgraph DataStores [" "]
        direction TB
        D3@{ shape: datastore, label: "<b>D3: QUERIES</b><br/>(Tickets DB)" }
        AdminDash(("Admin Dashboard<br/>(UI View)"))
    end

    %% =============================================================
    %% DATA FLOWS
    %% =============================================================

    %% --- 8.1 Fetch Queue ---
    Admin -->|"1. Open Query<br/>Management Section"| P8_1
    P8_1 <-->|"2. Read New/Unresolved<br/>Ticket Summaries"| D3
    P8_1 -->|"Alt A1: No Queries Message"| Admin
    
    %% --- 8.2 Retrieve Ticket ---
    Admin -->|"3. Select Specific Query"| P8_2
    P8_2 <-->|"4. Read Complete<br/>Query Details"| D3
    
    %% --- Error Handling (Alt A2) ---
    P8_1 & P8_2 -->|"Alt A2: Data Retrieval Error"| AdminDash
    
    %% --- 8.3 Parse & Render ---
    P8_1 -->|"5. Pass Ticket Summaries"| P8_3
    P8_2 -->|"6. Pass Full Ticket Payload"| P8_3
    P8_3 -->|"7. Apply Display Logic:<br/>Alt A3: Restrict Actions if<br/>Already Forwarded"| AdminDash
    P8_3 -->|"8. Render Details,<br/>Status & Student Info"| AdminDash

    %% -------------------------------------------------------------
    %% STYLING
    %% -------------------------------------------------------------
    style Actors fill:none, stroke:none
    style DataStores fill:none, stroke:none
    style SubProcesses fill:none, stroke:none