%%{init: {
  "flowchart": {
    "htmlLabels": true,
    "nodeSpacing": 35,
    "rankSpacing": 80,
    "padding": 15
  }
}}%%
flowchart LR

    %% -------------------------------------------------------------
    %% COLUMN 1: ACTORS
    %% -------------------------------------------------------------
    subgraph Actors [" "]
        direction TB
        TIC["<b>Teacher-in-Charge</b>"]
    end

    %% -------------------------------------------------------------
    %% COLUMN 2: SUB-PROCESSES (Decomposition of 14.0 - Request)
    %% -------------------------------------------------------------
    subgraph SubProcesses [" "]
        direction TB
        P14_1(("<b>14.1</b><br/>Render<br/>Request Form"))
        P14_2(("<b>14.2</b><br/>Validate<br/>Document Request"))
        P14_3(("<b>14.3</b><br/>Commit Request<br/>&amp; Update Status"))
        P14_4(("<b>14.4</b><br/>Dispatch Student<br/>Notification"))
    end

    %% -------------------------------------------------------------
    %% COLUMN 3: DATA STORES & INTERNAL ROUTING
    %% -------------------------------------------------------------
    subgraph DataStores [" "]
        direction TB
        D4@{ shape: datastore, label: "<b>D4: DOCUMENTS</b><br/>(File Metadata)" }
        D3@{ shape: datastore, label: "<b>D3: QUERIES</b><br/>(Tickets DB)" }
        P5(("<b>Process 5.0</b><br/>(Student Upload)"))
    end

    %% -------------------------------------------------------------
    %% COLUMN 4: EXTERNAL SERVICES & UI SINKS
    %% -------------------------------------------------------------
    subgraph ExtServices [" "]
        direction TB
        ExtEmail["Resend API<br/>(Email Svc)"]
    end

    %% =============================================================
    %% DATA FLOWS
    %% =============================================================

    %% --- 14.1 Render Form ---
    TIC -->|"1. Selects 'Need Document'<br/>on Assigned Query"| P14_1
    P14_1 -->|"2. Display Request Form"| TIC
    TIC -->|"Alt A2: Cancel Operation"| P14_1
    
    %% --- 14.2 Validate Request ---
    TIC -->|"3. Specifies Docs & Instructions"| P14_2
    P14_2 -->|"Alt A1: Process Multiple/Mandatory Docs"| P14_2
    P14_2 -->|"Alt A3: Validation Error<br/>(Missing Info)"| TIC
    
    %% --- 14.3 Commit Request ---
    P14_2 -->|"4. Validated Request Data"| P14_3
    P14_3 -->|"5. Insert Pending Doc Record<br/>(Linked to Query ID)"| D4
    P14_3 -->|"6. Update Ticket Status:<br/>'Documents Required'"| D3
    
    %% --- 14.4 Notify Student ---
    P14_3 -->|"7. Request Event Triggered"| P14_4
    P14_4 -->|"8. Dispatch Email Alert"| ExtEmail
    P14_4 -.->|"9. UI Prompt to Student"| P5

    %% -------------------------------------------------------------
    %% STYLING
    %% -------------------------------------------------------------
    style Actors fill:none, stroke:none
    style DataStores fill:none, stroke:none
    style SubProcesses fill:none, stroke:none
    style ExtServices fill:none, stroke:none