%%{init: {
  "flowchart": {
    "htmlLabels": true,
    "nodeSpacing": 40,
    "rankSpacing": 90,
    "padding": 15
  }
}}%%
flowchart LR

    %% -------------------------------------------------------------
    %% COLUMN 1: ACTORS
    %% -------------------------------------------------------------
    subgraph Actors [" "]
        direction TB
        TIC["<b>Teacher-in-Charge</b>"]
    end

    %% -------------------------------------------------------------
    %% COLUMN 2: SUB-PROCESSES (Decomposition of 16.0)
    %% -------------------------------------------------------------
    subgraph SubProcesses [" "]
        direction TB
        P16_1(("<b>16.1</b><br/>Render Meeting<br/>Context"))
        P16_2(("<b>16.2</b><br/>Validate Slot<br/>Availability"))
        P16_3(("<b>16.3</b><br/>Commit Booking<br/>or Cancellation"))
        P16_4(("<b>16.4</b><br/>Dispatch Alerts<br/>& Sync UI"))
    end

    %% -------------------------------------------------------------
    %% COLUMN 3: DATA STORES & ROUTING
    %% -------------------------------------------------------------
    subgraph DataStores [" "]
        direction TB
        D3@{ shape: datastore, label: "<b>D3: QUERIES</b><br/>(Tickets DB)" }
        D5@{ shape: datastore, label: "<b>D5: MEETINGS</b><br/>(Bookings DB)" }
    end

    %% -------------------------------------------------------------
    %% COLUMN 4: EXTERNAL SERVICES & UI SINKS
    %% -------------------------------------------------------------
    subgraph ExtServices [" "]
        direction TB
        ExtTimetable["Institutional<br/>Timetable Svc"]
        ExtEmail["Resend API<br/>(Email Svc)"]
        StudentDash(("Student Dashboard<br/>(UI View)"))
    end

    %% =============================================================
    %% DATA FLOWS
    %% =============================================================

    %% --- 16.1 Render Context ---
    TIC -->|"1. Opens Meeting Section<br/>for a Query"| P16_1
    P16_1 <-->|"2. Read Student Query<br/>Context"| D3
    P16_1 -->|"3. Display Context &<br/>Available Slots"| TIC
    
    %% --- 16.2 Validate Slot ---
    TIC -->|"4. Selects Target Slot"| P16_2
    P16_2 <-->|"5. Req: Verify Slot<br/>Res: Status"| ExtTimetable
    P16_2 <-->|"6. Check Local Conflicts"| D5
    P16_2 -->|"Alt A1: Verification Error<br/>(Service Unavailable)"| TIC
    
    %% --- 16.3 Commit Action ---
    P16_2 -->|"7. Slot Validated"| P16_3
    TIC -->|"8. Inputs Details /<br/>Alt A2: Submits Cancellation"| P16_3
    P16_3 -->|"9. Insert/Update Record<br/>Status: Booked or Cancelled"| D5
    
    %% --- 16.4 Dispatch Alerts ---
    P16_3 -->|"10. Booking/Cancel Event"| P16_4
    P16_4 -->|"11. Dispatch Email Alert"| ExtEmail
    P16_4 -->|"12. Make Details Visible"| StudentDash

    %% -------------------------------------------------------------
    %% STYLING
    %% -------------------------------------------------------------
    style Actors fill:none, stroke:none
    style DataStores fill:none, stroke:none
    style SubProcesses fill:none, stroke:none
    style ExtServices fill:none, stroke:none