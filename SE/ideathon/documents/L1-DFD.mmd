---
config:
  flowchart:
    htmlLabels: true
    nodeSpacing: 40
    rankSpacing: 120
    padding: 20
---
flowchart TB
 subgraph Actors[" "]
    direction TB
        Student["<b>Student</b>"]
        TIC["<b>Teacher-in-Charge</b>"]
        Admin["<b>Admin</b>"]
  end
 subgraph SP[" "]
    direction TB
        P1(("<b>1.0</b><br>Login / Auth"))
        P2(("<b>2.0</b><br>Ask AI Query"))
        P3(("<b>3.0</b><br>Raise New Query"))
        P4(("<b>4.0</b><br>Track Status"))
        P5(("<b>5.0</b><br>Upload Docs"))
        P6(("<b>6.0</b><br>View/Book Mtgs"))
  end
 subgraph AP[" "]
    direction TB
        P8(("<b>8.0</b><br>View New Queries"))
        P9(("<b>9.0</b><br>Resolve Directly"))
        P10(("<b>10.0</b><br>Forward Query"))
        P11(("<b>11.0</b><br>Manage KB"))
  end
 subgraph TP[" "]
    direction TB
        P12(("<b>12.0</b><br>View Assigned"))
        P13@{ label: "<b>13.0</b><br>Resolve Dept Q's" }
        P14(("<b>14.0</b><br>Request/Review Docs"))
        P15(("<b>15.0</b><br>View Timetable"))
        P16(("<b>16.0</b><br>Schedule/Cancel"))
  end
 subgraph SysP[" "]
        P7(("<b>7.0</b><br>Receive Alerts"))
  end
 subgraph Processes[" "]
        SP
        AP
        TP
        SysP
  end
 subgraph DataStores[" "]
    direction TB
        D1@{ shape: datastore, label: "<b>D1: USERS</b><br>(Auth DB)" }
        D2@{ shape: datastore, label: "<b>D2: KNOWLEDGE</b><br>(Vector DB)" }
        D3@{ shape: datastore, label: "<b>D3: QUERIES</b><br>(Tickets DB)" }
        D4@{ shape: datastore, label: "<b>D4: DOCUMENTS</b><br>(File Meta)" }
        D5@{ shape: datastore, label: "<b>D5: MEETINGS</b><br>(Bookings)" }
        D6@{ shape: datastore, label: "<b>D6: NOTIFICATIONS</b><br>(Status)" }
        D7@{ shape: datastore, label: "<b>D7: AUDIT_LOGS</b><br>(Actions)" }
  end
 subgraph ExtServices[" "]
    direction TB
        ExtAuth["College Database"]
        ExtLLM["Gemini API"]
        ExtS3["AWS S3"]
        ExtTimetable["Timetable Svc"]
        ExtEmail["Resend API"]
  end
    Student -- Auth --> P1
    Student -- Prompt --> P2
    Student -- Details --> P3
    Student -- Check --> P4
    Student -- File --> P5
    Student -- Slot --> P6
    Admin -- Auth --> P1
    Admin -- View --> P8
    Admin -- Resolution --> P9
    Admin -- Assign --> P10
    Admin -- Updates --> P11
    TIC -- Auth --> P1
    TIC -- View --> P12
    TIC -- Resolution --> P13
    TIC -- Doc Review --> P14
    TIC -- Check --> P15
    TIC -- Manage --> P16
    P1 -- Verify Identity --> ExtAuth
    P1 -- Read Role --> D1
    P1 -- Log Access --> D7
    P2 -- Semantic Search --> D2
    P2 -- Generate Ans --> ExtLLM
    P2 -- Log History --> D3
    P3 -- Create --> D3
    P4 -- Read --> D3
    P5 -- Save Binary --> ExtS3
    P5 -- Save Meta --> D4
    P5 -- Update Status --> D3
    P6 -- Read/Write --> D5
    P6 -- Check Conflict --> ExtTimetable
    P7 -- Poll Events --> D3 & D4 & D5
    P7 -- Log Delivery --> D6
    P7 -- Send Payload --> ExtEmail
    P8 -- Read --> D3
    P9 -- Update --> D3
    P9 -- Log Action --> D7
    P10 -- Update --> D3
    P11 -- Read Candidate --> D3
    P11 -- Get Embedding --> ExtLLM
    P11 -- Write Vector --> D2
    P11 -- Log Action --> D7
    P12 -- Read --> D3
    P13 -- Update --> D3
    P13 -- Log Action --> D7
    P14 -- Update Status --> D3
    P14 -- Read/Write Meta --> D4
    P14 -- Retrieve File --> ExtS3
    P15 -- Read Local --> D5
    P15 -- "Fetch Inst. Schedule" --> ExtTimetable
    P16 -- Lock Slot --> D5
    P16 -- Sync Schedule --> ExtTimetable

    P13@{ shape: circle}
     Student:::actorStyle
     TIC:::actorStyle
     Admin:::actorStyle
     P1:::processStyle
     P2:::processStyle
     P3:::processStyle
     P4:::processStyle
     P5:::processStyle
     P6:::processStyle
     P8:::processStyle
     P9:::processStyle
     P10:::processStyle
     P11:::processStyle
     P12:::processStyle
     P13:::processStyle
     P14:::processStyle
     P15:::processStyle
     P16:::processStyle
     P7:::processStyle
     D1:::storeStyle
     D2:::storeStyle
     D3:::storeStyle
     D4:::storeStyle
     D5:::storeStyle
     D6:::storeStyle
     D7:::storeStyle
     ExtAuth:::extStyle
     ExtLLM:::extStyle
     ExtS3:::extStyle
     ExtTimetable:::extStyle
     ExtEmail:::extStyle
    classDef processStyle fill:#fff,stroke:#333,stroke-width:1px,color:#000
    classDef storeStyle fill:#fff,stroke:#333,stroke-width:1px,color:#000
    classDef actorStyle fill:#fff,stroke:#333,stroke-width:1px,color:#000
    classDef extStyle fill:#fff,stroke:#333,stroke-width:1px,color:#000
    style SP fill:none,stroke:#333,stroke-width:1px
    style AP fill:none,stroke:#333,stroke-width:1px
    style TP fill:none,stroke:#333,stroke-width:1px
    style SysP fill:none,stroke:#333,stroke-width:1px
    style Actors fill:none,stroke:#333,stroke-width:1px
    style Processes fill:none,stroke:#333,stroke-width:1px
    style DataStores fill:none,stroke:#333,stroke-width:1px
    style ExtServices fill:none,stroke:#333,stroke-width:1px