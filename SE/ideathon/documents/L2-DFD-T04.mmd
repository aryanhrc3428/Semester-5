%%{init: {
  "flowchart": {
    "htmlLabels": true,
    "nodeSpacing": 35,
    "rankSpacing": 80,
    "padding": 15
  }
}}%%
flowchart LR

    %% -------------------------------------------------------------
    %% COLUMN 1: ACTORS
    %% -------------------------------------------------------------
    subgraph Actors [" "]
        direction TB
        TIC["<b>Teacher-in-Charge</b>"]
    end

    %% -------------------------------------------------------------
    %% COLUMN 2: SUB-PROCESSES (Decomposition of 14.0 - Review)
    %% -------------------------------------------------------------
    subgraph SubProcesses [" "]
        direction TB
        P14_5(("<b>14.5</b><br/>Fetch & Render<br/>Doc Content"))
        P14_6(("<b>14.6</b><br/>Validate Review<br/>Decision"))
        P14_7(("<b>14.7</b><br/>Commit Review<br/>& Update Status"))
        P14_8(("<b>14.8</b><br/>Dispatch Alerts<br/>& Route"))
    end

    %% -------------------------------------------------------------
    %% COLUMN 3: DATA STORES & INTERNAL ROUTING
    %% -------------------------------------------------------------
    subgraph DataStores [" "]
        direction TB
        D4@{ shape: datastore, label: "<b>D4: DOCUMENTS</b><br/>(File Metadata)" }
        D3@{ shape: datastore, label: "<b>D3: QUERIES</b><br/>(Tickets DB)" }
        D7@{ shape: datastore, label: "<b>D7: AUDIT_LOGS</b><br/>(System Actions)" }
        P14a[["<b>Process 14.0a</b><br/>(Request Docs)"]]
        P13[["<b>Process 13.0</b><br/>(Resolve Query)"]]
    end

    %% -------------------------------------------------------------
    %% COLUMN 4: EXTERNAL SERVICES & UI SINKS
    %% -------------------------------------------------------------
    subgraph ExtServices [" "]
        direction TB
        ExtS3["AWS S3 Bucket<br/>(Secure Storage)"]
        ExtEmail["Resend API<br/>(Email Svc)"]
    end

    %% =============================================================
    %% DATA FLOWS
    %% =============================================================

    %% --- 14.5 Fetch Doc ---
    TIC -->|"1. Opens Query &<br/>Selects Submitted Doc"| P14_5
    P14_5 <-->|"2. Read Doc Metadata"| D4
    P14_5 <-->|"3. Req: Secure Access<br/>4. Res: Pre-signed URL/File"| ExtS3
    P14_5 -->|"Alt A1: Retrieval Error Message"| TIC
    P14_5 -->|"5. Display Document Content"| TIC
    
    %% --- 14.6 Validate Decision ---
    TIC -->|"6. Submits Decision<br/>(Accept/Reject + Reason)"| P14_6
    P14_6 -->|"Alt A3: Needs Additional Doc"| P14a
    P14_6 -->|"7. Validated Decision Data<br/>(Alt A2: Rejection Reason)"| P14_7
    
    %% --- 14.7 Commit Review ---
    P14_7 -->|"8. Update Doc Status<br/>(Accepted/Rejected)"| D4
    P14_7 -->|"9. Update Query Status<br/>(If All Docs Verified)"| D3
    P14_7 -->|"10. Log TIC ID & Timestamp"| D7
    
    %% --- 14.8 Dispatch Alerts ---
    P14_7 -->|"11. Review Completed Event"| P14_8
    P14_8 -->|"12. Dispatch Outcome Alert<br/>(SR 6)"| ExtEmail
    P14_8 -.->|"13. Continue Processing Query"| P13

    %% -------------------------------------------------------------
    %% STYLING
    %% -------------------------------------------------------------
    classDef processStyle fill:#fff,stroke:#333,stroke-width:1px,color:#000
    classDef storeStyle fill:#fff,stroke:#333,stroke-width:1px,color:#000
    classDef actorStyle fill:#fff,stroke:#333,stroke-width:1px,color:#000
    classDef extStyle fill:#fff,stroke:#333,stroke-width:1px,color:#000
    classDef routeStyle fill:#fff,stroke:#333,stroke-width:1px,color:#000,stroke-dasharray: 5 5

    class P14_5,P14_6,P14_7,P14_8 processStyle;
    class D3,D4,D7 storeStyle;
    class P14a,P13 routeStyle;
    class TIC actorStyle;
    class ExtS3,ExtEmail extStyle;

    style Actors fill:none,stroke:#333,stroke-width:1px
    style SubProcesses fill:none,stroke:#333,stroke-width:1px
    style DataStores fill:none,stroke:#333,stroke-width:1px
    style ExtServices fill:none,stroke:#333,stroke-width:1px