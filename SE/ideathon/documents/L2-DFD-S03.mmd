%%{init: {
  "flowchart": {
    "htmlLabels": true,
    "nodeSpacing": 30,
    "rankSpacing": 80,
    "padding": 15
  }
}}%%
flowchart LR

    %% -------------------------------------------------------------
    %% COLUMN 1: ACTORS
    %% -------------------------------------------------------------
    subgraph Actors [" "]
        direction TB
        Student["<b>Student</b>"]
    end

    %% -------------------------------------------------------------
    %% COLUMN 2: SUB-PROCESSES (Decomposition of 3.0)
    %% -------------------------------------------------------------
    subgraph SubProcesses [" "]
        direction TB
        P3_1(("<b>3.1</b><br/>Form Render &<br/>Input Collection"))
        P3_2(("<b>3.2</b><br/>Validate<br/>Query Data"))
        P3_3(("<b>3.3</b><br/>Create Ticket<br/>Record"))
        P3_4(("<b>3.4</b><br/>Update Dashboard<br/>& Notify Admin"))
    end

    %% -------------------------------------------------------------
    %% COLUMN 3: DATA STORES
    %% -------------------------------------------------------------
    subgraph DataStores [" "]
        direction TB
        D3@{ shape: datastore, label: "<b>D3: QUERIES</b><br/>(Tickets DB)" }
        D7@{ shape: datastore, label: "<b>D7: AUDIT_LOGS</b><br/>(Tracking)" }
    end

    %% -------------------------------------------------------------
    %% COLUMN 4: EXTERNAL SERVICES & SINKS
    %% -------------------------------------------------------------
    subgraph ExtServices [" "]
        direction TB
        AdminDash(("Admin Dashboard<br/>(UI View)"))
        ExtEmail["Resend API<br/>(Email Svc)"]
    end

    %% =============================================================
    %% DATA FLOWS
    %% =============================================================

    %% --- 3.1 Input Collection ---
    Student -->|"1. Selects 'Raise Query' &<br/>Enters Details"| P3_1
    P3_1 -->|"Alt A3: Discard Unsaved &<br/>Return to Prev Page"| Student
    
    %% --- 3.2 Validation ---
    P3_1 -->|"2. Submit Query Data"| P3_2
    P3_2 -->|"Alt A1: Validation Error<br/>(Incomplete/Invalid)"| Student
    
    %% --- 3.3 Create Record ---
    P3_2 -->|"3. Validated Data<br/>(No Duplicates)"| P3_3
    P3_3 -->|"4. Insert Record<br/>(Status: New)"| D3
    P3_3 -->|"5. Securely Store<br/>Audit Trail"| D7
    P3_3 -->|"Alt A2: Submission<br/>Failure Error"| Student
    P3_3 -->|"6. Clear Confirmation<br/>Message"| Student
    
    %% --- 3.4 Notify & Update ---
    P3_3 -->|"7. Ticket Created<br/>Event"| P3_4
    P3_4 -->|"8. Make Available for<br/>Further Processing"| AdminDash
    P3_4 -->|"9. Notify Administrator<br/>of New Query"| ExtEmail

    %% -------------------------------------------------------------
    %% STYLING
    %% -------------------------------------------------------------
    style Actors fill:none, stroke:none
    style DataStores fill:none, stroke:none
    style SubProcesses fill:none, stroke:none
    style ExtServices fill:none, stroke:none