%%{init: {"theme": "default"}}%%
erDiagram

    %% =====================================================================
    %% CORE IDENTITY & ACCESS ENTITIES
    %% Validated against: L2-DFD-T01 (Login/Authenticate)
    %% Note: No session store observed in any L2 diagram -> auth is
    %% treated as stateless (e.g. JWT); no SESSION entity persisted.
    %% =====================================================================

    ROLE {
        int role_id PK
        string role_name "Student | Admin | TIC"
        string description
        string permissions_json
    }

    DEPARTMENT {
        int department_id PK
        string department_name
        string department_code
        string hod_name
    }

    USER {
        int user_id PK
        int role_id FK
        int department_id FK "nullable - null for cross-dept admins"
        string full_name
        string email
        string college_id_number
        string academic_year "nullable - students only"
        boolean is_active
        datetime created_at
        datetime last_login_at
    }

    %% =====================================================================
    %% QUERY LIFECYCLE ENTITIES
    %% Validated against: L2-DFD-S02 (Ask AI), S03 (Raise Query),
    %% S04 (Track Status), A01 (View New), A02 (Monitor & Resolve),
    %% A03 (Forward to TIC), T02 (View Assigned), T03 (Review & Resolve)
    %% =====================================================================

    QUERY {
        int query_id PK
        int student_id FK
        int department_id FK "nullable - set once categorized/forwarded"
        string description
        string category "nullable - AI/Admin categorized"
        string status "New | Pending Review | Forwarded | Documents Required | Documents Verified | Resolved | Closed"
        string source "AI Escalation | Direct Raise"
        text ai_response_text "nullable"
        float ai_confidence_score "nullable"
        text resolution_text "nullable"
        int resolved_by FK "nullable - references USER"
        datetime submission_date
        datetime resolved_at "nullable"
        datetime updated_at
    }

    QUERY_ASSIGNMENT {
        int assignment_id PK
        int query_id FK
        int assigned_to FK "references USER - TIC/Admin"
        int assigned_by FK "references USER - Admin"
        int department_id FK
        string assignment_status "Assigned | Reassigned | Withdrawn"
        datetime assigned_at
    }

    %% =====================================================================
    %% KNOWLEDGE BASE ENTITY
    %% Validated against: L2-DFD-S02 (Ask AI - semantic search),
    %% L2-DFD-A04 (Manage & Maintain KB)
    %% =====================================================================

    KNOWLEDGE_BASE_ENTRY {
        int kb_id PK
        int department_id FK "nullable - null = institution-wide"
        int verified_by FK "references USER - Admin"
        int source_query_id FK "nullable - resolution promoted to KB"
        string title
        text content
        vector embedding_vector
        string category
        string status "Active | Inactive | Archived"
        datetime created_at
        datetime updated_at
    }

    %% =====================================================================
    %% DOCUMENT ENTITY (MERGED)
    %% Validated against: L2-DFD-T04a (Request Docs) + T04b (Review Docs)
    %% + L2-DFD-S05 (Upload). Only ONE store, D4: DOCUMENTS, appears
    %% across all diagrams - a "Pending" record is inserted at request
    %% time and the SAME store is updated/appended at upload/review time.
    %% Corrected: DOCUMENT_REQUEST merged into DOCUMENT via status field.
    %% =====================================================================

    DOCUMENT {
        int document_id PK
        int query_id FK
        int requested_by FK "nullable - references USER, Admin/TIC"
        int uploaded_by FK "nullable - references USER, Student, until uploaded"
        int reviewed_by FK "nullable - references USER, until reviewed"
        string document_name "requested name/type"
        string instructions "nullable"
        boolean is_mandatory
        string file_name "nullable - populated on upload"
        string file_type "nullable"
        int file_size_kb "nullable"
        string storage_key "nullable - AWS S3 object key"
        string status "Pending | Submitted | Under Review | Accepted | Rejected"
        string review_comment "nullable"
        datetime requested_at
        datetime uploaded_at "nullable"
        datetime reviewed_at "nullable"
    }

    %% =====================================================================
    %% MEETING ENTITY
    %% Validated against: L2-DFD-T05 (View Timetable) + L2-DFD-T06
    %% (Schedule/Cancel) + L2-DFD-S06 (View/Request/Accept Meeting)
    %% Corrected: TIMETABLE_AVAILABILITY removed - no persisted local
    %% timetable store exists; institutional schedule is fetched LIVE
    %% from the external Timetable Service and merged in-memory with
    %% this table's booking records (D5: MEETINGS is the only store).
    %% =====================================================================

    MEETING {
        int meeting_id PK
        int query_id FK "nullable - meetings may cover general dept matters"
        int student_id FK "references USER"
        int tic_id FK "references USER"
        date meeting_date
        time meeting_time
        int duration_minutes
        string mode "In-person | Online"
        string location_or_link
        string status "Proposed | Accepted | Booked | Declined | Cancelled | Completed"
        boolean slot_verified_externally "result of live Timetable Svc check"
        string cancellation_reason "nullable"
        datetime created_at
        datetime updated_at
    }

    %% =====================================================================
    %% NOTIFICATION ENTITY
    %% Validated against: L2-DFD-S07 (Receive Notifications) - confirms
    %% D6: NOTIFICATIONS store with unread state + delivery status log.
    %% =====================================================================

    NOTIFICATION {
        int notification_id PK
        int recipient_id FK "references USER"
        int related_query_id FK "nullable"
        int related_document_id FK "nullable"
        int related_meeting_id FK "nullable"
        string event_type "Query Update | Resolution | Doc Request | Doc Submitted | Meeting Scheduled | Meeting Cancelled"
        string message
        string delivery_channel "Email | In-App"
        string delivery_status "Sent | Failed | Pending"
        boolean is_read
        datetime created_at
        datetime read_at "nullable"
    }

    %% =====================================================================
    %% AUDIT LOG ENTITY
    %% Validated & renamed to match D7: AUDIT_LOGS, confirmed active in:
    %% L2-DFD-S03 (Raise Query), A02 (Monitor & Resolve),
    %% A03 (Forward to TIC), A04 (Manage KB), T04b (Review Docs)
    %% =====================================================================

    AUDIT_LOG {
        int audit_id PK
        int performed_by FK "references USER"
        string action_type "Create | Update | Resolve | Forward | Upload | Review | Schedule | Cancel"
        string entity_type "Query | Document | Meeting | KnowledgeBaseEntry"
        int entity_id
        text old_value "nullable"
        text new_value "nullable"
        string ip_address
        datetime timestamp
    }

    %% =====================================================================
    %% RELATIONSHIPS
    %% =====================================================================

    ROLE ||--o{ USER : "classifies"
    DEPARTMENT ||--o{ USER : "employs / enrolls"

    USER ||--o{ QUERY : "raises (Student)"
    USER ||--o{ QUERY : "resolves (Admin/TIC)"
    DEPARTMENT ||--o{ QUERY : "categorized under"

    QUERY ||--o{ QUERY_ASSIGNMENT : "routed via"
    USER ||--o{ QUERY_ASSIGNMENT : "assigned to (TIC)"
    USER ||--o{ QUERY_ASSIGNMENT : "assigned by (Admin)"
    DEPARTMENT ||--o{ QUERY_ASSIGNMENT : "scopes"

    QUERY ||--o| KNOWLEDGE_BASE_ENTRY : "promoted to"
    USER ||--o{ KNOWLEDGE_BASE_ENTRY : "verifies (Admin)"
    DEPARTMENT ||--o{ KNOWLEDGE_BASE_ENTRY : "scopes"

    QUERY ||--o{ DOCUMENT : "requires / attached to"
    USER ||--o{ DOCUMENT : "requests (Admin/TIC)"
    USER ||--o{ DOCUMENT : "uploads (Student)"
    USER ||--o{ DOCUMENT : "reviews (Admin/TIC)"

    QUERY ||--o{ MEETING : "leads to"
    USER ||--o{ MEETING : "attends (Student)"
    USER ||--o{ MEETING : "attends (TIC)"

    USER ||--o{ NOTIFICATION : "receives"
    QUERY ||--o{ NOTIFICATION : "triggers"
    DOCUMENT ||--o{ NOTIFICATION : "triggers"
    MEETING ||--o{ NOTIFICATION : "triggers"

    USER ||--o{ AUDIT_LOG : "performs"