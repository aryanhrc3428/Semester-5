%%{init: {
  "flowchart": {
    "htmlLabels": true,
    "nodeSpacing": 40,
    "rankSpacing": 90,
    "padding": 15
  }
}}%%
flowchart LR

    %% -------------------------------------------------------------
    %% COLUMN 1: ACTORS
    %% -------------------------------------------------------------
    subgraph Actors [" "]
        direction TB
        TIC["<b>Teacher-in-Charge</b>"]
    end

    %% -------------------------------------------------------------
    %% COLUMN 2: SUB-PROCESSES (Decomposition of 12.0)
    %% -------------------------------------------------------------
    subgraph SubProcesses [" "]
        direction TB
        P12_1(("<b>12.1</b><br/>Fetch &amp; Filter<br/>Dept Queue"))
        P12_2(("<b>12.2</b><br/>Retrieve Specific<br/>Ticket Details"))
        P12_3(("<b>12.3</b><br/>Parse State &amp;<br/>Render Dashboard"))
    end

    %% -------------------------------------------------------------
    %% COLUMN 3: DATA STORES & UI SINKS
    %% -------------------------------------------------------------
    subgraph DataStores [" "]
        direction TB
        D3@{ shape: datastore, label: "<b>D3: QUERIES</b><br/>(Tickets DB)" }
        TICDash(("TIC Dashboard<br/>(UI View)"))
    end

    %% =============================================================
    %% DATA FLOWS
    %% =============================================================

    %% --- 12.1 Fetch Queue ---
    TIC -->|"1. Open Assigned Queries Section"| P12_1
    P12_1 <-->|"2. Read Tickets filtered by<br/>Dept/TIC ID (SR 2)"| D3
    P12_1 -->|"Alt A1: No Assigned Queries Message"| TICDash
    
    %% --- 12.2 Retrieve Ticket ---
    TIC -->|"3. Select Specific Query"| P12_2
    P12_2 <-->|"4. Read Complete Details &<br/>Student Info (SR 3)"| D3
    
    %% --- Error Handling (Alt A3) ---
    P12_1 & P12_2 -->|"Alt A3: Retrieval Error Message"| TICDash
    
    %% --- 12.3 Parse & Render ---
    P12_1 -->|"5. Pass Ticket Summaries"| P12_3
    P12_2 -->|"6. Pass Full Ticket Payload"| P12_3
    P12_3 -->|"7. Apply Logic: Alt A2<br/>(Read-Only if Resolved)"| TICDash
    P12_3 -->|"8. Render Details & Next Actions"| TICDash

    %% -------------------------------------------------------------
    %% STYLING
    %% -------------------------------------------------------------
    style Actors fill:none, stroke:none
    style DataStores fill:none, stroke:none
    style SubProcesses fill:none, stroke:none