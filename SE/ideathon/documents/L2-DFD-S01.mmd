%%{init: {
  "flowchart": {
    "htmlLabels": true,
    "nodeSpacing": 40,
    "rankSpacing": 90,
    "padding": 15
  }
}}%%
flowchart LR

    %% -------------------------------------------------------------
    %% COLUMN 1: ACTORS
    %% -------------------------------------------------------------
    subgraph Actors [" "]
        direction TB
        User["<b>Registered User</b><br/>(Student/Admin/TIC)"]
    end

    %% -------------------------------------------------------------
    %% COLUMN 2: SUB-PROCESSES (Decomposition of 1.0)
    %% -------------------------------------------------------------
    subgraph SubProcesses [" "]
        direction TB
        P1_1(("<b>1.1</b><br/>Render Login<br/>Interface"))
        P1_2(("<b>1.2</b><br/>Validate<br/>Credentials"))
        P1_3(("<b>1.3</b><br/>Apply RBAC &<br/>Identity Check"))
        P1_4(("<b>1.4</b><br/>Establish Session<br/>& Redirect"))
    end

    %% -------------------------------------------------------------
    %% COLUMN 3: DATA STORES
    %% -------------------------------------------------------------
    subgraph DataStores [" "]
        direction TB
        D1@{ shape: datastore, label: "<b>D1: USERS</b><br/>(Auth/Role DB)" }
    end

    %% -------------------------------------------------------------
    %% COLUMN 4: EXTERNAL SERVICES & UI SINKS
    %% -------------------------------------------------------------
    subgraph ExtServices [" "]
        direction TB
        ExtAuth["College Authentication<br/>Service"]
        RoleDashboards(("Role-Specific<br/>Dashboards"))
    end

    %% =============================================================
    %% DATA FLOWS
    %% =============================================================

    %% --- 1.1 Render Interface ---
    User -->|"1. Opens Login Page"| P1_1
    P1_1 -->|"2. Displays Interface"| User
    
    %% --- 1.2 Validate Credentials ---
    User -->|"3. Submits Official Credentials<br/>(HTTPS: SR 1)"| P1_2
    P1_2 <-->|"4. Req: Send Credentials<br/>5. Res: Verification Result"| ExtAuth
    P1_2 -->|"Alt A1: Invalid Credentials Msg (SR 4)<br/>Alt A2: Service Unavailable Msg"| User
    
    %% --- 1.3 Apply RBAC ---
    P1_2 -->|"6. Validated External Auth"| P1_3
    P1_3 <-->|"7. Retrieve Identity & Role<br/>(Apply RBAC: SR 2)"| D1
    P1_3 -->|"Alt A3: Access Denied Msg<br/>(Inactive/Unauthorized Account)"| User
    
    %% --- 1.4 Establish Session ---
    P1_3 -->|"8. Verified Identity & Role"| P1_4
    P1_4 -->|"9. Secure Session Token<br/>(w/ Expiration: SR 3)"| User
    P1_4 -->|"10. Redirect Target URL"| RoleDashboards

    %% -------------------------------------------------------------
    %% STYLING
    %% -------------------------------------------------------------
    style Actors fill:none, stroke:none
    style DataStores fill:none, stroke:none
    style SubProcesses fill:none, stroke:none
    style ExtServices fill:none, stroke:none