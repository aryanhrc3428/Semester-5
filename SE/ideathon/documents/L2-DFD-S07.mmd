%%{init: {
  "flowchart": {
    "htmlLabels": true,
    "nodeSpacing": 35,
    "rankSpacing": 80,
    "padding": 15
  }
}}%%
flowchart LR

    %% -------------------------------------------------------------
    %% COLUMN 1: TRIGGERS & ACTORS
    %% -------------------------------------------------------------
    subgraph Triggers [" "]
        direction TB
        SysEvents[["<b>System Events</b><br/>(from Core Processes)"]]
        Student["<b>Student / User</b>"]
    end

    %% -------------------------------------------------------------
    %% COLUMN 2: SUB-PROCESSES (Decomposition of 7.0)
    %% -------------------------------------------------------------
    subgraph SubProcesses [" "]
        direction TB
        P7_1(("<b>7.1</b><br/>Identify Event<br/>&amp; Recipient"))
        P7_2(("<b>7.2</b><br/>Generate Payload<br/>(Email &amp; In-App)"))
        P7_3(("<b>7.3</b><br/>Dispatch Email<br/>&amp; Log Status"))
        P7_4(("<b>7.4</b><br/>Render In-App<br/>Notification"))
    end

    %% -------------------------------------------------------------
    %% COLUMN 3: DATA STORES
    %% -------------------------------------------------------------
    subgraph DataStores [" "]
        direction TB
        D1@{ shape: datastore, label: "<b>D1: USERS</b><br/>(Auth DB)" }
        D6@{ shape: datastore, label: "<b>D6: NOTIFICATIONS</b><br/>(History & Status)" }
    end

    %% -------------------------------------------------------------
    %% COLUMN 4: EXTERNAL SERVICES & SINKS
    %% -------------------------------------------------------------
    subgraph ExtServices [" "]
        direction TB
        ExtEmail["Resend API<br/>(Email Svc)"]
        UserDashboard(["User Dashboard<br/>(UI View)"])
    end

    %% =============================================================
    %% DATA FLOWS
    %% =============================================================

    %% --- 7.1 Identify Recipient ---
    SysEvents -->|"1. Triggering Event<br/>(e.g., Query Resolved)"| P7_1
    P7_1 <-->|"2. Lookup user_id<br/>3. Return {email_id}"| D1
    
    %% --- 7.2 Generate Payload ---
    P7_1 -->|"4. Event Data & Recipient"| P7_2
    P7_2 -->|"5. Store In-App Notification<br/>(Unread State)"| D6
    
    %% --- 7.3 Dispatch Email ---
    P7_2 -->|"6. Formatted Email Payload"| P7_3
    P7_3 -->|"7. Send Async Request"| ExtEmail
    ExtEmail -->|"8. Alt A1: Delivery Status<br/>(Success or Failure)"| P7_3
    P7_3 -->|"9. Update Delivery Status Log"| D6
    
    %% --- 7.4 Render In-App Notification ---
    Student -->|"10. Opens Notification UI"| P7_4
    P7_4 <-->|"11. Fetch Notification History"| D6
    P7_4 -->|"12. Display Unread/Read<br/>Event Summaries"| UserDashboard

    %% -------------------------------------------------------------
    %% STYLING
    %% -------------------------------------------------------------
    classDef processStyle fill:#fff,stroke:#333,stroke-width:1px,color:#000
    classDef storeStyle fill:#fff,stroke:#333,stroke-width:1px,color:#000
    classDef actorStyle fill:#fff,stroke:#333,stroke-width:1px,color:#000
    classDef extStyle fill:#fff,stroke:#333,stroke-width:1px,color:#000
    classDef triggerStyle fill:#fff,stroke:#333,stroke-width:1px,color:#000,stroke-dasharray: 5 5

    class P7_1,P7_2,P7_3,P7_4 processStyle;
    class D1,D6 storeStyle;
    class Student actorStyle;
    class SysEvents triggerStyle;
    class ExtEmail,UserDashboard extStyle;

    style Triggers fill:none,stroke:#333,stroke-width:1px
    style SubProcesses fill:none,stroke:#333,stroke-width:1px
    style DataStores fill:none,stroke:#333,stroke-width:1px
    style ExtServices fill:none,stroke:#333,stroke-width:1px