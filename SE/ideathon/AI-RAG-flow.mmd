%%{init: {
  "flowchart": {
    "htmlLabels": true,
    "nodeSpacing": 30,
    "rankSpacing": 60,
    "padding": 15
  }
}}%%
flowchart LR

    %% -------------------------------------------------------------
    %% STYLING
    %% -------------------------------------------------------------
    classDef process fill:#fff,stroke:#333,stroke-width:1px,color:#000;
    classDef human fill:#fff,stroke:#333,stroke-width:1px,color:#000;
    classDef db fill:#fff,stroke:#333,stroke-width:1px,color:#000;
    classDef ext fill:#fff,stroke:#333,stroke-width:1px,color:#000;
    classDef dec fill:#fff,stroke:#333,stroke-width:1px,color:#000;

    %% -------------------------------------------------------------
    %% PHASE 1: AI RAG RESOLUTION (MATH FLOW)
    %% -------------------------------------------------------------
    subgraph Phase1 [" "]
        direction TB
        A(["<b>Student Submits Query</b>"]) --> B["<b>Gemini API Embedding</b><br/><i>Eq = f(Student Query)</i>"]
        B --> C["<b>pgvector Search (D2: KNOWLEDGE)</b><br/><i>Similarity(q,d) = (q·d) / (||q|| ||d||)</i>"]
        C --> D["<b>Evaluate System Metric</b><br/><i>Conf = f(Similarity, Relevance, Source Validity)</i>"]
        D --> E{"Confidence > T ?"}
        E -->|"Yes: Grounded Answer"| F["<b>Serve AI Answer</b><br/>(Instant Resolution)"]
    end

    %% -------------------------------------------------------------
    %% PHASE 2: ESCALATION & ROUTING LOGIC
    %% -------------------------------------------------------------
    subgraph Phase2 [" "]
        direction TB
        E -->|"No: Escalate (Conf < T)"| G["<b>Create DB Ticket</b><br/>D3: QUERIES (Status: Open)"]
        G --> H["<b>Admin Queue</b><br/>Staff Reviews Query"]
        H --> I{"Admin Routing<br/>Decision"}
        I -->|"Resolve Directly"| J["Admin Drafts Solution"]
        I -->|"Forward to Dept"| K["<b>Gemini API Suggests TIC</b><br/><i>Assigned TIC = Routing(Query, Dept, Subject)</i>"]
        K --> L["TIC Drafts Solution"]
    end

    %% -------------------------------------------------------------
    %% PHASE 3: VALIDATION & DOCUMENT LOOP
    %% -------------------------------------------------------------
    subgraph Phase3 [" "]
        direction TB
        J & L --> M{"Additional Docs<br/>Required?"}
        M -->|"Yes"| N["Update Status:<br/>'Documents Required'"]
        N --> O["<b>Student Uploads File (AWS S3)</b><br/><i>Valid = FileType_valid AND (FileSize &lt; MaxSize)</i>"]
        O --> P["Write File Metadata to<br/>D4: DOCUMENTS"]
        P --> Q["Staff Reviews & Accepts<br/>Submitted Document"]
        M -->|"No"| R
        Q --> R["Finalize Verified<br/>Resolution Text"]
    end

    %% -------------------------------------------------------------
    %% PHASE 4: RESOLUTION & EMBEDDING GENERATION
    %% -------------------------------------------------------------
    subgraph Phase4 [" "]
        direction TB
        R --> S["<b>Commit Resolution</b><br/>Update D3 Status: 'Resolved'"]
        S --> T["<b>Audit Trail</b><br/>Log Action in D7: AUDIT_LOGS"]
        T --> U["<b>Resend API</b><br/>Dispatch Student Alert"]
        
        %% KB Update Loop
        U --> V["Flag Verified Resolution<br/>as KB Candidate"]
        V --> W["<b>Admin Approves Entry</b><br/><i>E_kb = f(KB Content)</i>"]
        W --> X@{ shape: datastore, label: "<b>D2: KNOWLEDGE</b><br/>Store Text + Vector Together" }
    end

    %% Apply Classes
    class B,K,O,U,W ext;
    class C,G,P,S,T,X db;
    class D,E,I,M dec;
    class A,F,H,J,L,N,Q,R,V human;

    style Phase1 fill:none,stroke:#333,stroke-width:1px
    style Phase2 fill:none,stroke:#333,stroke-width:1px
    style Phase3 fill:none,stroke:#333,stroke-width:1px
    style Phase4 fill:none,stroke:#333,stroke-width:1px