1: procedure ResolveQueryRAG(student_query, threshold_T)
2:     // 1. Initial Type, Null, and Boundary Validation
3:     if student_query is null or threshold_T is null
4:     then
5:         return error "Validation Failed: Inputs cannot be null"
6:     end if
7:     if typeof(student_query) != "string" or typeof(threshold_T) != "float"
8:     then
9:         return error "Validation Failed: Invalid data types"
10:    end if
11:    if length(student_query) < 5 or length(student_query) > 1000
12:    then
13:        return error "Validation Failed: Query length out of bounds"
14:    end if
15:    if threshold_T < 0.0 or threshold_T > 1.0
16:    then
17:        return error "Validation Failed: Threshold must be between 0.0 and 1.0"
18:    end if
19:    // 2. Generate Embedding with Network Resilience
20:    query_embedding <- null
21:    try
22:        query_embedding <- call GeminiAPI_GenerateEmbedding(student_query)
23:        if query_embedding is null or length(query_embedding) = 0
24:        then
25:            return error "API Error: Failed to generate valid embedding vector"
26:        end if
27:    catch NetworkException as net_err
28:        logError(net_err)
29:        return error "System Error: AI Embedding service unavailable"
30:    end try
31:    // 3. Secure Database Retrieval
32:    candidate_entries <- empty list
33:    try
34:        query_string <- "SELECT kb_id, content, source, embedding FROM D2_KNOWLEDGE WHERE validity_status = ?"
35:        candidate_entries <- executeParameterizedQuery(query_string, ["Active"])
36:        if candidate_entries is empty
37:        then
38:            return response "Escalation Required", action "Raise Query to Admin", reason "Knowledge Base empty"
39:        end if
40:    catch DatabaseException as db_err
41:        logError(db_err)
42:        return error "Database Error: Failed to retrieve Knowledge Base entries"
43:    end try
44:    // 4. Explicit Cosine Similarity Math (No "Magic" Functions)
45:    results <- empty priority queue
46:    for each entry in candidate_entries
47:    do
48:        if entry.embedding is not null and length(entry.embedding) = length(query_embedding)
49:        then
50:            dot_product <- 0.0
51:            magnitude_q <- 0.0
52:            magnitude_e <- 0.0
53:            // Explicitly iterate through the vector arrays
54:            for i <- 0 to length(query_embedding) - 1
55:            do
56:                dot_product <- dot_product + (query_embedding[i] * entry.embedding[i])
57:                magnitude_q <- magnitude_q + (query_embedding[i] * query_embedding[i])
58:                magnitude_e <- magnitude_e + (entry.embedding[i] * entry.embedding[i])
59:            end for
60:            magnitude_q <- sqrt(magnitude_q)
61:            magnitude_e <- sqrt(magnitude_e)
62:            // Prevent division by zero
63:            if magnitude_q > 0 and magnitude_e > 0
64:            then
65:                similarity_score <- dot_product / (magnitude_q * magnitude_e)
66:                insert (entry, similarity_score) into results
67:            end if
68:        end if
69:    end for
70:    // 5. Evaluate Threshold and Extract Top K
71:    sort results descending by similarity_score
72:    top_k_context <- extract top 5 valid entries from results
73:    if length(top_k_context) = 0 or results[0].similarity_score < threshold_T
74:    then
75:        return response "Escalation Required", action "Raise Query to Admin"
76:    end if
77:    // 6. Generate Grounded AI Response
78:    try
79:        ai_answer <- call GeminiAPI_GenerateGroundedResponse(student_query, top_k_context)
80:        if ai_answer is null or length(ai_answer) = 0
81:        then
82:            return response "Escalation Required", action "Raise Query to Admin", reason "AI Generation Failed"
83:        end if
84:        sources_list <- extract source fields from top_k_context
85:        return success "Grounded Answer", ai_answer, sources_list
86:    catch NetworkException as net_err
87:        logError(net_err)
88:        return error "System Error: AI Generation service unavailable"
89:    end try
90: end procedure