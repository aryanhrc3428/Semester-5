1: procedure DispatchNotificationAsync(target, event_type, reference_id)
2:     // 1. Initial Type and Null Validation
3:     if target is null or event_type is null or reference_id is null
4:     then
5:         return error "Validation Failed: Inputs cannot be null"
6:     end if
7:     if typeof(target) != "string" or typeof(event_type) != "string"
8:     then
9:         return error "Validation Failed: Invalid data types"
10:    end if
11:    // 2. Validate Event Type
12:    valid_events <- array of strings {"New Query Escalated", "Query Assigned", "Query Resolved", "Document Required", "Document Uploaded", "Document Accepted", "Document Rejected", "Meeting Scheduled", "Meeting Cancelled"}
13:    is_valid_event <- false
14:    for i <- 0 to length(valid_events) - 1
15:    do
16:        if event_type = valid_events[i]
17:        then
18:            is_valid_event <- true
19:            break
20:        end if
21:    end for
22:    if is_valid_event = false
23:    then
24:        return error "Validation Failed: Unrecognized event type"
25:    end if
26:    // 3. Resolve Target to Email Addresses
27:    recipient_emails <- empty list
28:    try
29:        // Check if target is a Role
30:        if target = "Admin" or target = "TIC" or target = "Staff"
31:        then
32:            role_query <- "SELECT U.email FROM USERS U JOIN ROLE R ON U.role_id = R.role_id WHERE R.role_name = ?"
33:            // If Staff, we need both Admin and TIC
34:            if target = "Staff"
35:            then
36:                 role_query <- "SELECT U.email FROM USERS U JOIN ROLE R ON U.role_id = R.role_id WHERE R.role_name IN ('Admin', 'TIC')"
37:                 role_records <- executeParameterizedQuery(role_query, [])
38:            else
39:                 role_records <- executeParameterizedQuery(role_query, [target])
40:            end if
41:            for each record in role_records
42:            do
43:                append record.email to recipient_emails
44:            end for
45:        // Otherwise, assume target is a specific User ID
46:        else
47:            user_query <- "SELECT email FROM USERS WHERE user_id = ?"
48:            user_record <- executeParameterizedQuery(user_query, [target])
49:            if user_record is not empty
50:            then
51:                append user_record.email to recipient_emails
52:            end if
53:        end if
54:    catch DatabaseException as db_err
55:        logError(db_err)
56:        return error "Database Error: Failed to resolve target email addresses"
57:    end try
58:    if length(recipient_emails) = 0
59:    then
60:        return error "Resolution Error: No valid email addresses found for target"
61:    end if
62:    // 4. Construct Email Content (Template Builder Mock)
63:    email_subject <- concat("System Notification: ", event_type)
64:    email_body <- concat("An event '", event_type, "' has occurred concerning reference ID: ", reference_id, ". Please log in to your dashboard to view details.")
65:    // 5. Dispatch Loop with Individual Error Handling
66:    success_count <- 0
67:    failure_count <- 0
68:    current_time <- getSystemTimestamp()
69:    for each email_address in recipient_emails
70:    do
71:        try
72:            // Simulating external email provider call (e.g., Resend/SendGrid)
73:            api_response <- call ExternalEmailService(email_address, email_subject, email_body)
74:            if api_response.status_code = 200
75:            then
76:                success_count <- success_count + 1
77:                // Log successful dispatch
78:                try
79:                     log_query <- "INSERT INTO D7_AUDIT_LOGS (user_id, action_type, entity, entity_id, timestamp) VALUES (?, ?, ?, ?, ?)"
80:                     executeParameterizedInsert(log_query, ["System", concat("Email Sent to ", email_address), "Notification", reference_id, current_time])
81:                catch DatabaseException as db_log_err
82:                     logError("Warning: Failed to log notification success for " + email_address)
83:                end try
84:            else
85:                failure_count <- failure_count + 1
86:                logError("Email API Error: Failed to send to " + email_address + " with status " + api_response.status_code)
87:            end if
88:        catch NetworkException as net_err
89:            failure_count <- failure_count + 1
90:            logError("Network Error: Could not reach email service for " + email_address)
91:        end try
92:    end for
93:    if success_count > 0
94:    then
95:        return success concat("Dispatched ", success_count, " notifications. Failures: ", failure_count)
96:    else
97:        return error "Dispatch Failed: Unable to send any notifications"
98:    end if
99: end procedure