1: procedure ManageMeeting(tic_id, action_type, meeting_data)
2:     // 1. Initial Type and Null Validation
3:     if tic_id is null or action_type is null or meeting_data is null
4:     then
5:         return error "Validation Failed: Core parameters cannot be null"
6:     end if
7:     if typeof(tic_id) != "string" or typeof(action_type) != "string" or typeof(meeting_data) != "dictionary"
8:     then
9:         return error "Validation Failed: Invalid parameter data types"
10:    end if
11:    // 2. Explicit Action Type Validation Loop
12:    valid_actions <- array of strings {"Schedule", "Cancel"}
13:    is_valid_action <- false
14:    for i <- 0 to length(valid_actions) - 1
15:    do
16:        if action_type = valid_actions[i]
17:        then
18:            is_valid_action <- true
19:            break
20:        end if
21:    end for
22:    if is_valid_action = false
23:    then
24:        return error "Validation Failed: Action must be 'Schedule' or 'Cancel'"
25:    end if
26:    // 3. Strict Role-Based Access Control (RBAC) Validation
27:    try
28:        rbac_query <- "SELECT R.role_name FROM USERS U JOIN ROLE R ON U.role_id = R.role_id WHERE U.user_id = ?"
29:        role_record <- executeParameterizedQuery(rbac_query, [tic_id])
30:        if role_record is empty or role_record.role_name != "TIC"
31:        then
32:            return error "Security Error: Unauthorized access. TIC privileges required."
33:        end if
34:    catch DatabaseException as db_err
35:        logError(db_err)
36:        return error "System Error: Unable to validate permissions"
37:    end try
38:    current_time <- getSystemTimestamp()
39:    student_id_target <- null
40:    reference_id <- null
41:    notification_type <- ""
42:    // 4. Branch A: Schedule Meeting
43:    if action_type = "Schedule"
44:    then
45:        if meeting_data["query_id"] is null or meeting_data["date"] is null or meeting_data["start_time"] is null or meeting_data["end_time"] is null
46:        then
47:            return error "Validation Failed: Incomplete meeting scheduling data"
48:        end if
49:        try
50:            // Verify Query Ownership (IDOR Prevention)
51:            query_check <- "SELECT assigned_tic, student_id FROM D3_QUERIES WHERE query_id = ?"
52:            target_query <- executeParameterizedQuery(query_check, [meeting_data["query_id"]])
53:            if target_query is empty or target_query.assigned_tic != tic_id
54:            then
55:                return error "Security Error: Cannot schedule meeting for an unassigned or invalid query"
56:            end if
57:            student_id_target <- target_query.student_id
58:            // Concurrency Control: Double-Booking Prevention at Database Level
59:            // Overlap Math: (existing_start < new_end) AND (existing_end > new_start)
60:            overlap_check <- "SELECT meeting_id FROM D5_MEETINGS WHERE assigned_tic = ? AND meeting_date = ? AND status != ? AND start_time < ? AND end_time > ?"
61:            conflict_record <- executeParameterizedQuery(overlap_check, [tic_id, meeting_data["date"], "Cancelled", meeting_data["end_time"], meeting_data["start_time"]])
62:            if conflict_record is not empty
63:            then
64:                return error "Concurrency Error: Time slot has already been booked (Race Condition Prevented)"
65:            end if
66:            // Transaction: Insert Meeting and Audit
67:            reference_id <- generateSecureUUID()
68:            beginTransaction()
69:            insert_meeting <- "INSERT INTO D5_MEETINGS (meeting_id, query_id, assigned_tic, student_id, meeting_date, start_time, end_time, status, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)"
70:            executeParameterizedInsert(insert_meeting, [reference_id, meeting_data["query_id"], tic_id, student_id_target, meeting_data["date"], meeting_data["start_time"], meeting_data["end_time"], "Scheduled", current_time])
71:            insert_audit <- "INSERT INTO D7_AUDIT_LOGS (user_id, action_type, entity, entity_id, timestamp) VALUES (?, ?, ?, ?, ?)"
72:            executeParameterizedInsert(insert_audit, [tic_id, "Schedule Meeting", "Meeting", reference_id, current_time])
73:            commitTransaction()
74:            notification_type <- "Meeting Scheduled"
75:        catch DatabaseException as db_err
76:            rollbackTransaction()
77:            logError(db_err)
78:            return error "Database Error: Failed to schedule meeting safely"
79:        end try
80:    // 5. Branch B: Cancel Meeting
81:    else if action_type = "Cancel"
82:    then
83:        if meeting_data["meeting_id"] is null
84:        then
85:            return error "Validation Failed: Meeting ID required for cancellation"
86:        end if
87:        reference_id <- meeting_data["meeting_id"]
88:        try
89:            // Verify Meeting Ownership and State (IDOR Prevention)
90:            meeting_check <- "SELECT assigned_tic, student_id, status FROM D5_MEETINGS WHERE meeting_id = ?"
91:            target_meeting <- executeParameterizedQuery(meeting_check, [reference_id])
92:            if target_meeting is empty
93:            then
94:                return error "Database Error: Meeting reference not found"
95:            end if
96:            if target_meeting.assigned_tic != tic_id
97:            then
98:                return error "Security Error: Unauthorized attempt to cancel another TIC's meeting"
99:            end if
100:           if target_meeting.status = "Cancelled"
101:           then
102:               return error "State Error: Meeting is already cancelled"
103:           end if
104:           student_id_target <- target_meeting.student_id
105:           // Transaction: Update Meeting and Audit
106:           beginTransaction()
107:           cancel_update <- "UPDATE D5_MEETINGS SET status = ?, updated_at = ? WHERE meeting_id = ?"
108:           executeParameterizedUpdate(cancel_update, ["Cancelled", current_time, reference_id])
109:           insert_audit <- "INSERT INTO D7_AUDIT_LOGS (user_id, action_type, entity, entity_id, timestamp) VALUES (?, ?, ?, ?, ?)"
110:           executeParameterizedInsert(insert_audit, [tic_id, "Cancel Meeting", "Meeting", reference_id, current_time])
111:           commitTransaction()
112:           notification_type <- "Meeting Cancelled"
113:       catch DatabaseException as db_err
114:           rollbackTransaction()
115:           logError(db_err)
116:           return error "Database Error: Failed to cancel meeting safely"
117:       end try
118:   end if
119:   // 6. Fire-and-Forget Asynchronous Notification
120:   try
121:       call DispatchNotificationAsync(student_id_target, notification_type, reference_id)
122:   catch NetworkException as net_err
123:       logError("Warning: Failed to dispatch meeting notification to student for meeting " + reference_id)
124:   end try
125:   return success concat("Meeting successfully ", action_type, "d"), reference_id
126: end procedure