1: procedure AdminViewNewQueries(admin_id)
2:     // 1. Initial Type and Null Validation
3:     if admin_id is null
4:     then
5:         return error "Validation Failed: Admin ID cannot be null"
6:     end if
7:     if typeof(admin_id) != "string"
8:     then
9:         return error "Validation Failed: Invalid data type for Admin ID"
10:    end if
11:    // 2. Strict Role-Based Access Control (RBAC) Validation
12:    try
13:        rbac_query <- "SELECT R.role_name FROM USERS U JOIN ROLE R ON U.role_id = R.role_id WHERE U.user_id = ?"
14:        role_record <- executeParameterizedQuery(rbac_query, [admin_id])
15:        if role_record is empty
16:        then
17:            return error "Database Error: Admin identity not found"
18:        end if
19:        if role_record.role_name != "Admin"
20:        then
21:            return error "Security Error: Unauthorized access. Admin privileges required."
22:        end if
23:    catch DatabaseException as db_err
24:        logError(db_err)
25:        return error "System Error: Unable to validate permissions"
26:    end try
27:    // 3. Secure Base Query Retrieval
28:    open_queries <- empty list
29:    try
30:        // Fetch only queries with "Open" status, sorted chronologically
31:        query_string <- "SELECT * FROM D3_QUERIES WHERE status = ? ORDER BY created_at ASC"
32:        open_queries <- executeParameterizedQuery(query_string, ["Open"])
33:    catch DatabaseException as db_err
34:        logError(db_err)
35:        return error "Database Error: Failed to retrieve open queries"
36:    end try
37:    // If no open queries exist, return gracefully
38:    if length(open_queries) = 0
39:    then
40:        return success "No new queries found", empty list
41:    end if
42:    // 4. Data Aggregation Loop for Dashboard Context
43:    admin_dashboard_view <- empty list
44:    for i <- 0 to length(open_queries) - 1
45:    do
46:        current_query <- open_queries[i]
47:        student_details <- initialize new dictionary
48:        // Resolve student details within an isolated try-catch to prevent dashboard failure
49:        try
50:            student_sql <- "SELECT name, email FROM USERS WHERE user_id = ?"
51:            student_record <- executeParameterizedQuery(student_sql, [current_query.student_id])
52:            if student_record is not empty
53:            then
54:                student_details["name"] <- student_record.name
55:                student_details["email"] <- student_record.email
56:            else
57:                student_details["name"] <- "Unknown Student"
58:                student_details["email"] <- "Unknown Email"
59:            end if
60:        catch DatabaseException as db_err
61:            logError("Warning: Failed to load student details for query " + current_query.query_id)
62:            student_details["name"] <- "Data unavailable"
63:            student_details["email"] <- "Data unavailable"
64:        end try
65:        // 5. Construct Compiled Record
66:        compiled_record <- initialize new dictionary
67:        compiled_record["query_details"] <- current_query
68:        compiled_record["student_info"] <- student_details
69:        // Append to final view array
70:        insert compiled_record into admin_dashboard_view at index i
71:    end for
72:    return success "Admin dashboard data retrieved successfully", admin_dashboard_view
73: end procedure