1: procedure LoadStudentDashboard(student_id)
2:     // 1. Initial Type and Null Validation
3:     if student_id is null
4:     then
5:         return error "Validation Failed: Student ID cannot be null"
6:     end if
7:     if typeof(student_id) != "string"
8:     then
9:         return error "Validation Failed: Invalid data type for Student ID"
10:    end if
11:    // 2. Validate User Existence (Relational Integrity)
12:    try
13:        auth_check <- "SELECT user_id FROM USERS WHERE user_id = ?"
14:        auth_record <- executeParameterizedQuery(auth_check, [student_id])
15:        if auth_record is empty
16:        then
17:            return error "Database Error: Student identity not found"
18:        end if
19:    catch DatabaseException as db_err
20:        logError(db_err)
21:        return error "System Error: Unable to validate user identity"
22:    end try
23:    // 3. Retrieve Base Queries (Relying on DB Engine for optimized sorting)
24:    student_queries <- empty list
25:    try
26:        query_string <- "SELECT * FROM D3_QUERIES WHERE student_id = ? ORDER BY updated_at DESC"
27:        student_queries <- executeParameterizedQuery(query_string, [student_id])
28:    catch DatabaseException as db_err
29:        logError(db_err)
30:        return error "Database Error: Failed to retrieve student queries"
31:    end try
32:    // If no queries exist, return the empty dashboard successfully
33:    if length(student_queries) = 0
34:    then
35:        return success "No queries found", empty list
36:    end if
37:    // 4. Data Aggregation Loop (Nested Retrievals)
38:    dashboard_view <- empty list
39:    for i <- 0 to length(student_queries) - 1
40:    do
41:        current_query <- student_queries[i]
42:        associated_docs <- empty list
43:        associated_meetings <- empty list
44:        // Wrap nested queries in a try-catch to prevent a single corrupted relation from crashing the whole dashboard
45:        try
46:            doc_sql <- "SELECT document_id, file_name, status FROM D4_DOCUMENTS WHERE query_id = ?"
47:            associated_docs <- executeParameterizedQuery(doc_sql, [current_query.query_id])
48:            meeting_sql <- "SELECT meeting_id, date, start_time, status FROM D5_MEETINGS WHERE query_id = ?"
49:            associated_meetings <- executeParameterizedQuery(meeting_sql, [current_query.query_id])
50:        catch DatabaseException as db_err
51:            logError("Warning: Failed to load relations for query " + current_query.query_id)
52:            associated_docs <- "Data unavailable"
53:            associated_meetings <- "Data unavailable"
54:        end try
55:        // 5. Construct Compiled Record
56:        compiled_record <- initialize new dictionary
57:        compiled_record["query_details"] <- current_query
58:        compiled_record["documents"] <- associated_docs
59:        compiled_record["meetings"] <- associated_meetings
60:        // Append to final view array
61:        insert compiled_record into dashboard_view at index i
62:    end for
63:    return success "Dashboard data retrieved successfully", dashboard_view
64: end procedure